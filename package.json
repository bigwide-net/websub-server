{
  "name": "websub-server",
  "version": "1.0.0",
  "description": "Minimal WebSub hub for a fixed set of configured feeds",
  "private": true,
  "main": "server.ts",
  "scripts": {
    "start": "npx ts-node server.ts",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
  "author": "Tim Jansen",
  "license": "MIT",
  "dependencies": {
    "@downread/happy-server": "^1.1.0",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "json5": "^2.2.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
