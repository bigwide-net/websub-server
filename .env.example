WEBSUB_CONFIG=./websub.json5
WEBSUB_VAR=./var
#WEBSUB_PORT=3050
#WEBSUB_BASE_URL=http://localhost:3050

# Development only: allow callbacks and feeds on private addresses (localhost etc.)
#WEBSUB_ALLOW_PRIVATE_TARGETS=true

# Rate limits (see lib/limits.middleware.ts), e.g.
#LIMITS_MAX_PER_IP_PER_MINUTE=30

# /happy health endpoint secret (@downread/happy-server); 'none' disables auth
HAPPY_SECRET=<secret>
DEBUG=false
